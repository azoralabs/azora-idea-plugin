<idea-plugin>
    <id>org.azora.lang.idea</id>
    <name>Azora Language</name>
    <version>0.0.7</version>
    <vendor email="support@azora.dev" url="https://azora.dev">AzoraLabs</vendor>
    <description><![CDATA[
        Full language support for the <b>Azora</b> programming language (0.0.5).

        <ul>
            <li>Syntax highlighting in Azora's own palette — shared with the Azora code playground — with bold keywords, purple macros, colored string interpolation, and highlighted smart casts</li>
            <li>Macros and annotations are discovered from current <code>macro @name</code> and <code>annot Name</code> declarations in your project, SDK, and dependencies</li>
            <li>Context-aware completion: real members after <code>.</code> and <code>::</code>, real module paths in imports, a type's fields in its constructor call</li>
            <li>Live templates for every Azora declaration form</li>
            <li>Go-to-declaration and quick documentation that resolve symbols by scope and use-site context, including local shadowing, members, imports, stdlib, and dependencies</li>
            <li>Inferred-type inlay hints, toggleable per project</li>
            <li>Errors and unused-local warnings underlined precisely, with naming, shorthand, numeric, import, annotation, string, and bracket quick fixes</li>
            <li>Run gutter icons on current <code>func main</code> forms and every <code>test</code></li>
            <li><code>.azon</code> manifest and data support with validation, automatic indentation, code-style settings, and Reformat Code, plus executable, library, and multi-module workspace project templates</li>
            <li>Brace matching, folding, structure view, find usages, commenting, and Azora/AZON indentation</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- The source, and beside it the IR the compiler makes of it. -->
        <fileEditorProvider implementation="org.azora.lang.idea.preview.AzoraSplitEditorProvider"/>
        <!-- ── Azora language ──────────────────────────────────────── -->

        <fileType
            name="Azora"
            implementationClass="org.azora.lang.idea.AzoraFileType"
            fieldName="INSTANCE"
            language="Azora"
            extensions="az"/>

        <lang.parserDefinition
            language="Azora"
            implementationClass="org.azora.lang.idea.AzoraParserDefinition"/>

        <!-- Syntax highlighting -->
        <lang.syntaxHighlighterFactory
            language="Azora"
            implementationClass="org.azora.lang.idea.highlighting.AzoraSyntaxHighlighterFactory"/>

        <colorSettingsPage
            implementation="org.azora.lang.idea.highlighting.AzoraColorSettingsPage"/>

        <!-- Semantic highlighting: macros, calls, types, smart casts -->
        <annotator
            language="Azora"
            implementationClass="org.azora.lang.idea.annotator.AzoraSemanticAnnotator"/>

        <!-- Diagnostics and quick fixes -->
        <externalAnnotator
            language="Azora"
            implementationClass="org.azora.lang.idea.annotator.AzoraExternalAnnotator"/>

        <!-- Formatting and indentation -->
        <langCodeStyleSettingsProvider
            implementation="org.azora.lang.idea.formatting.AzoraCodeStyleSettingsProvider"/>

        <lang.formatter
            language="Azora"
            implementationClass="org.azora.lang.idea.formatting.AzoraFormattingModelBuilder"/>

        <lineIndentProvider
            implementation="org.azora.lang.idea.formatting.AzoraLineIndentProvider"/>

        <!-- Completion and templates -->
        <completion.contributor
            language="Azora"
            implementationClass="org.azora.lang.idea.completion.AzoraCompletionContributor"/>

        <liveTemplateContext
            contextId="Azora"
            implementation="org.azora.lang.idea.completion.AzoraTemplateContextType"/>

        <defaultLiveTemplates file="/liveTemplates/Azora.xml"/>

        <!-- Navigation and documentation -->
        <gotoDeclarationHandler
            implementation="org.azora.lang.idea.navigation.AzoraGoToDeclarationHandler"/>

        <!-- Optimize Imports: `import path.*` becomes the selection it stands for -->
        <lang.importOptimizer
            language="Azora"
            implementationClass="org.azora.lang.idea.symbol.AzoraImportOptimizer"/>

        <!-- Alt-Enter on a name that exists but is not imported here -->
        <intentionAction>
            <language>Azora</language>
            <className>org.azora.lang.idea.annotator.AzoraImportIntention</className>
            <category>Azora</category>
        </intentionAction>

        <lang.documentationProvider
            language="Azora"
            implementationClass="org.azora.lang.idea.documentation.AzoraDocumentationProvider"/>

        <!-- Inlay hints -->
        <codeInsight.declarativeInlayProvider
            language="Azora"
            providerId="azora.inferred.types"
            bundle="messages.AzoraBundle"
            nameKey="inlay.azora.type.hints"
            descriptionKey="inlay.azora.type.hints.description"
            group="TYPES_GROUP"
            implementationClass="org.azora.lang.idea.hints.AzoraTypeHintProvider"/>

        <!-- Editing -->
        <highlightUsagesHandlerFactory
            implementation="org.azora.lang.idea.highlighting.AzoraGroupPairHighlighterFactory"/>

        <lang.braceMatcher
            language="Azora"
            implementationClass="org.azora.lang.idea.AzoraBraceMatcher"/>

        <lang.commenter
            language="Azora"
            implementationClass="org.azora.lang.idea.AzoraCommenter"/>

        <lang.foldingBuilder
            language="Azora"
            implementationClass="org.azora.lang.idea.folding.AzoraFoldingBuilder"/>

        <lang.psiStructureViewFactory
            language="Azora"
            implementationClass="org.azora.lang.idea.structure.AzoraStructureViewFactory"/>

        <lang.findUsagesProvider
            language="Azora"
            implementationClass="org.azora.lang.idea.findusages.AzoraFindUsagesProvider"/>

        <!-- ── AZON: manifests and data files ──────────────────────── -->

        <fileType
            name="AZON"
            implementationClass="org.azora.lang.idea.azon.AzonFileType"
            fieldName="INSTANCE"
            language="AZON"
            extensions="azon"/>

        <lang.parserDefinition
            language="AZON"
            implementationClass="org.azora.lang.idea.azon.AzonParserDefinition"/>

        <lang.syntaxHighlighterFactory
            language="AZON"
            implementationClass="org.azora.lang.idea.azon.AzonSyntaxHighlighterFactory"/>

        <annotator
            language="AZON"
            implementationClass="org.azora.lang.idea.azon.AzonAnnotator"/>

        <langCodeStyleSettingsProvider
            implementation="org.azora.lang.idea.azon.AzonCodeStyleSettingsProvider"/>

        <lang.formatter
            language="AZON"
            implementationClass="org.azora.lang.idea.azon.AzonFormattingModelBuilder"/>

        <lineIndentProvider
            implementation="org.azora.lang.idea.azon.AzonLineIndentProvider"/>

        <!-- ── Project model ───────────────────────────────────────── -->

        <projectService
            serviceImplementation="org.azora.lang.idea.symbol.AzoraSymbolService"/>

        <projectService
            serviceImplementation="org.azora.lang.idea.symbol.AzoraMacroIndex"/>

        <projectService
            serviceImplementation="org.azora.lang.idea.build.AzoraProjectConfigService"/>

        <postStartupActivity
            implementation="org.azora.lang.idea.build.AzoraProjectStartupActivity"/>

        <editorNotificationProvider
            implementation="org.azora.lang.idea.build.AzoraManifestSyncNotification"/>

        <newProjectWizard.generator
            implementation="org.azora.lang.idea.project.AzoraNewProjectWizard"/>

        <!-- ── Running and testing ─────────────────────────────────── -->

        <configurationType
            implementation="org.azora.lang.idea.run.AzoraConfigurationType"/>

        <!-- Test first: a `test` gutter icon should run tests, not main. -->
        <runConfigurationProducer
            implementation="org.azora.lang.idea.run.AzoraRunTestProducer"/>

        <runConfigurationProducer
            implementation="org.azora.lang.idea.run.AzoraRunInterpretProducer"/>

        <runConfigurationProducer
            implementation="org.azora.lang.idea.run.AzoraRunNativeProducer"/>

        <runLineMarkerContributor
            language="Azora"
            implementationClass="org.azora.lang.idea.run.AzoraRunLineMarkerContributor"/>
    </extensions>

    <actions>
        <action
            id="Azora.NewProject"
            class="org.azora.lang.idea.project.AzoraNewProjectAction"
            text="Azora Project"
            description="Create a new Azora project"
            icon="/icons/azora_icon.png">
            <add-to-group group-id="NewGroup" anchor="first"/>
            <add-to-group group-id="WelcomeScreen.QuickStart" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
